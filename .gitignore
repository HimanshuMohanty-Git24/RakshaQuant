# Explicit entries only: no blanket patterns such as *.json or lib/ that silently drop sources.

# Secrets / local environment
.env
.env.local
.env.*.local
.claude/settings.local.json

# Runtime state: everything lives under var/<environment>/ (see Settings.state_dir)
var/
*.db
*.sqlite3
logs/
*.log

# Python build artefacts and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
/parts/
/sdist/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# Test, coverage, lint and type-check output
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Frontend build output
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# Editors / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local scratch, not project sources
AgentContext/
.tmp-ui-shots/
