# RakshaQuant - environment template. Copy to .env and set only what you use: every key is
# optional, and the demo needs none. Unknown keys are ignored. The full list, with types and
# defaults, is docs/reference/settings.md; the risk limits (RISK_*) are docs/reference/risk.md.
# Never commit .env.

# -- Environment -------------------------------------------------------------------------------
# dev | paper | demo | test. The month run uses paper; each environment has its own
# var/<environment>/ state, so ad-hoc runs never touch the experiment.
ENVIRONMENT=paper
# LOG_LEVEL=INFO                       # JSON-lines logs under var/logs/

# -- LLM providers: set only the ones your roles use ------------------------------------------------
# An enabled role whose provider key is missing stops startup (exit 2). See docs/runbooks/providers.md.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_COMPAT_BASE_URL=                 # any other OpenAI-compatible endpoint ("compat:<model>")
# LLM_COMPAT_API_KEY=
# LLM_TIMEOUT_S=20

# -- LLM roles: "provider:model" (switch providers by editing one line; empty = role off) ---------
# veto = book C's advisor (part of the experiment's treatment: don't change it mid-run).
# LLM_ROLE_VETO=openrouter:<vendor>/<model>:free    # check current free ids on openrouter.ai/models
# LLM_ROLE_VETO_FALLBACKS=groq:llama-3.3-70b-versatile
# LLM_ROLE_VETO_EFFORT=low             # low | medium | high | max, where the model supports it
# LLM_ROLE_REVIEW=anthropic:claude-sonnet-5-5         # nightly post-trade review (stored, never fed back)
# LLM_ROLE_LABEL=anthropic:claude-opus-5-5            # calibration labels (paid; dry run by default)

# -- LLM budgets, in INR (0 = unlimited) ----------------------------------------------------------
# USD_INR=88                           # model prices are in USD: keep this rate current
# LLM_BUDGET_DAILY_INR=200             # all roles, per IST day
# LLM_BUDGET_ROLE_DAILY_INR={"veto": 50}
# LLM_BUDGET_PER_DECISION_INR=10
# LLM_OPENROUTER_DENY_DATA_COLLECTION=true
# LLM_ANTHROPIC_FALLBACKS=true

# -- Typed decision models: Laya (local, book B) -> Jev (TypeSafe, escalation) ---------------------
# Laya needs the decision-local extra (uv sync --extra decision-local); without it book B abstains.
# DECISION_LAYA_ENABLED=true
# DECISION_LAYA_CHECKPOINT=multilingual   # english | multilingual | typed-decisions (benchmark: multilingual)
# TYPESAFE_API_KEY=                    # Jev; without it, questions Laya is unsure of abstain
# TYPESAFE_MODEL=jev-1.13.0
# DECISION_ESCALATE_LOW=0.35           # calibrated confidence inside [low, high] escalates to Jev
# DECISION_ESCALATE_HIGH=0.65
# DECISION_SHADOW_PCT=0.20             # Laya-only states also sent to Jev to measure agreement

# -- Corporate announcements (NSE RSS; see open question OQ-2 in docs/plan/PROGRESS.md) ------------
# ANNOUNCEMENTS_ENABLED=true

# -- Telegram: the daily summary and the dead-man alert --------------------------------------------
# TELEGRAM_BOT_TOKEN=                  # from @BotFather
# TELEGRAM_CHAT_ID=                    # from @userinfobot
# TELEGRAM_ENABLED=true

# -- Reporting -------------------------------------------------------------------------------------
# INFRA_COST_INR_PER_DAY=              # power, data and API plans, for the daily report's net figures

# -- Execution -------------------------------------------------------------------------------------
# The engine trades on the simulated broker only. Anything but local_paper or shadow is ignored,
# with a warning.
# EXECUTION_MODE=local_paper

# -- Risk limits: RISK_<NAME> (bounded; out-of-range values stop startup) --------------------------
# Changing any limit changes the experiment (its hash is pre-registered). Examples:
# RISK_RISK_PER_TRADE=0.02
# RISK_DAILY_LOSS_LIMIT_PCT=0.01
# RISK_MAX_DRAWDOWN_PCT=0.05

# -- DhanHQ (optional): only scripts/test_dhan_connection.py uses these ----------------------------
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=
# DHAN_BASE_URL=https://api.dhan.co/v2  # https://sandbox.dhan.co/v2 for sandbox tokens
